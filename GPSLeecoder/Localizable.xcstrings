    "settings_gps_intermittent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS turns on only when recording (battery saving)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録時のみGPS動作（省電力）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 시에만 GPS 작동 (배터리 절약)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS activé uniquement à l'enregistrement (économie de batterie)"
          }
