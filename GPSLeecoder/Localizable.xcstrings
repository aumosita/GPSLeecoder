    "onboarding_title" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "정확한 위치 권한이 필요합니다" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Location Access Required" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Accès à la localisation requis" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "位置情報のアクセス許可が必要です" } }
      }
    },
    "onboarding_description" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "GPX 트랙을 기록하려면 앱이 실행 중일 때는 물론, 선택적으로 백그라운드에서도 위치 접근 권한이 필요할 수 있습니다." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To record GPX tracks, this app needs location access while in use, and optionally in the background." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pour enregistrer des traces GPX, cette application a besoin d'accéder à votre position en cours d'utilisation, et éventuellement en arrière-plan." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "GPXトラックを記録するには、アプリ使用中の位置情報アクセスが必要です。バックグラウンドでの記録にはオプションで常時アクセスが必要です。" } }
      }
    },
    "onboarding_when_in_use" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 사용 중 위치 접근(필수)" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "While Using the App (required)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pendant l'utilisation (obligatoire)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリ使用中のアクセス（必須）" } }
      }
    },
    "onboarding_always" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "항상 허용(선택) — 백그라운드 기록 안정성 향상" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Always Allow (optional) — improves background recording" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Toujours autoriser (optionnel) — améliore l'enregistrement en arrière-plan" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "常に許可（任意） — バックグラウンド記録の安定性向上" } }
      }
    },
    "onboarding_request_when_in_use" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 사용 중 허용 요청" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Request While Using" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Demander pendant l'utilisation" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "使用中のアクセスを要求" } }
      }
    },
    "onboarding_request_always" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "항상 허용 요청 (백그라운드 기록)" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Request Always (Background Recording)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Demander l'accès permanent (enregistrement en arrière-plan)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "常時許可を要求（バックグラウンド記録）" } }
