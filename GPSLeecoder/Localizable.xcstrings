    "onboarding_always" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always Allow (optional) — improves background recording"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours autoriser (optionnel) — améliore l'enregistrement en arrière-plan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に許可（任意） — バックグラウンド記録の安定性向上"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 허용(선택) — 백그라운드 기록 안정성 향상"
          }
        }
      }
    },
    "onboarding_denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is denied. Please change it in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la localisation est refusé. Veuillez le modifier dans les Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報のアクセスが拒否されています。設定で変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 거부되었습니다. 설정에서 변경해주세요."
          }
        }
      }
    },
    "onboarding_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To record GPX tracks, this app needs location access while in use, and optionally in the background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour enregistrer des traces GPX, cette application a besoin d'accéder à votre position en cours d'utilisation, et éventuellement en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPXトラックを記録するには、アプリ使用中の位置情報アクセスが必要です。バックグラウンドでの記録にはオプションで常時アクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX 트랙을 기록하려면 앱이 실행 중일 때는 물론, 선택적으로 백그라운드에서도 위치 접근 권한이 필요할 수 있습니다."
          }
        }
      }
    },
    "onboarding_footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change permissions anytime in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez modifier les autorisations à tout moment dans les Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定からいつでも権限を変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제든 설정에서 권한을 변경할 수 있습니다."
          }
        }
      }
    },
