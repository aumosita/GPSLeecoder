    "settings_filters_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance Filter: minimum movement (m) to trigger a new GPS point. Accuracy Filter: discard points with GPS accuracy worse than this value."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離フィルター: 新しいGPSポイントを記録する最小移動距離(m)。精度フィルター: この値より精度が低いポイントを除外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리 필터: 새 GPS 포인트를 기록할 최소 이동거리(m). 정확도 필터: GPS 정확도가 이 값보다 나쁜 포인트를 무시합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre de distance : mouvement minimum (m) pour enregistrer un nouveau point GPS. Filtre de précision : ignore les points dont la précision GPS est supérieure à cette valeur."
          }
        }
      }
    },
