      }
    },
    "settings_gps_power_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under 5 sec: GPS stays on continuously. 5 sec or more: GPS turns on only at each recording point to save battery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5秒未満: GPS連続動作。5秒以上: 記録の度にGPSをON/OFFし、バッテリーを節約します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5초 미만: GPS 연속 작동. 5초 이상: 기록 시점에만 GPS를 켜고 꺼서 배터리를 절약합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de 5 sec : GPS en continu. 5 sec ou plus : GPS activé uniquement à chaque point de mesure pour économiser la batterie."
          }
        }
      }
    },
